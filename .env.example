# Local dev — SQLite file inside prisma/ (gitignored, never deploy this):
DATABASE_URL="file:./dev.db"

# --- Demo hosting on Vercel (no database; FOR DEMO ONLY) ---
# In the Vercel dashboard (Settings → Environment Variables) set:
#   DATABASE_URL="file:/tmp/saam-demo.db"
#   DEMO_MODE="true"
# On first boot the app creates that file, creates tables, and seeds the demo
# accounts + workbook data automatically. Demo logins:
#   admin@samaanta.org.np / Admin@2083  (ADMIN)
#   board@samaanta.org.np / Board@2083  (VIEWER)
# Every Vercel instance gets its own throwaway copy: edits evaporate on
# redeploys and cold starts. NEVER use DEMO_MODE with real data.
#
# --- Real production (later) ---
# Switch prisma/schema.prisma to provider="postgresql", point DATABASE_URL at
# Neon (pooled URL), then: prisma db push && npm run db:seed (direct URL).
